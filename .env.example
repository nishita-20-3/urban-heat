# PostgreSQL PostGIS Database Connection URL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/uhi_db

# Application Configuration
APP_NAME=Urban Heat Decision-Support API
APP_VERSION=1.0.0
DEBUG=False

# Connection Pooling Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=True

# CORS Configuration (comma-separated or JSON list)
CORS_ORIGINS=["*"]
